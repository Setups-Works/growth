# Setups Works Growth configuration.
#
#   cp .env.example .env
#
# docker compose reads this file. The three REQUIRED values must be set before
# the first `docker compose up`; everything else is optional and the app tells
# you in the UI what is missing.

# ── Required ────────────────────────────────────────────────────────────────

# Password for the bundled PostgreSQL container. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs session cookies and WooCommerce state tokens. Generate: openssl rand -hex 32
AUTH_SECRET=

# Shared secret between the `cron` container and /api/cron/*. Generate: openssl rand -hex 32
CRON_SECRET=


# ── App ─────────────────────────────────────────────────────────────────────

# Public address the app is reached at. WooCommerce only delivers store
# credentials to an HTTPS callback, so connecting a store needs HTTPS — use
# the `https` compose profile with DOMAIN below, or any HTTPS reverse proxy.
APP_URL=http://localhost:3000

# Canonical origin for sitemaps/OG tags. Build-time: rebuild after changing.
NEXT_PUBLIC_SITE_URL=

# Host port the app is published on.
APP_PORT=3000

# Set to true to stop new accounts being created (existing users can still sign in).
DISABLE_SIGNUPS=false

# Minutes a store's analytics snapshot stays memoised in memory.
SNAPSHOT_CACHE_MINUTES=10

# ── HTTPS (optional, `docker compose --profile https up -d`) ────────────────
# A domain whose DNS A record points at this server. Caddy obtains and renews
# a Let's Encrypt certificate automatically. Set APP_URL=https://<DOMAIN> too.
DOMAIN=

# ── Database ────────────────────────────────────────────────────────────────
# Defaults are fine for the bundled container. DATABASE_URL is assembled by
# docker-compose.yml; set it yourself only when running outside compose or
# against a managed database (e.g. Azure Database for PostgreSQL:
# postgres://user:pass@host:5432/growth?sslmode=require).
POSTGRES_DB=growth
POSTGRES_USER=growth
# DATABASE_URL=
# DATABASE_POOL_SIZE=10
# DATABASE_PREPARE=true

# ── Email (optional) ────────────────────────────────────────────────────────
# Used for password-reset links. Without SMTP_HOST the link is printed to the
# app log instead: `docker compose logs app | grep reset-password`.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── WhatsApp ────────────────────────────────────────────────────────────────
# WhatsApp is built in: each account links its number by scanning a QR in
# Settings → WhatsApp (like WhatsApp Web). It runs inside the app; set
# WHATSAPP_DISABLED=true to turn it off. Defaults for new accounts:
WHATSAPP_DISABLED=false
# Country code for numbers without one, digits only — e.g. 91 for India.
WHATSAPP_DIAL_CODE=
# Pause between sends, in milliseconds (minimum 1000).
WHATSAPP_SEND_DELAY_MS=

# ── Billing (Razorpay, optional) ────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_GO=
RAZORPAY_PLAN_ID_PLUS=
RAZORPAY_PLAN_ID_LITE=
# Same as RAZORPAY_KEY_ID; build-time, used by Checkout.js in the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── AI assistant (optional) ─────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=
GROQ_FALLBACK_MODEL=

# ── WhatsApp Cloud API pilot (optional, /whatsapp-cloud-pilot) ──────────────
WHATSAPP_CLOUD_TEST_TOKEN=
WHATSAPP_CLOUD_TEST_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_TEST_WABA_ID=
